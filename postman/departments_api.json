			"name": "Get Single Department",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/departments/1",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"departments",
						"1"
					]
				}
			}
		}
